{
    "name": "backend-mongoose-template",
    "version": "1.0.0",
    "private": true,
    "description": "Production-grade backend template with Express, Mongoose, Redis, and clean architecture.",
    "engines": {
        "node": ">=20.11.0"
    },
    "scripts": {
        "dev": "nodemon",
        "dev:nodemon": "nodemon",
        "dev:ts": "ts-node --transpile-only -r tsconfig-paths/register ./src/server.ts",
        "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json && npm run copy-templates",
        "copy-templates": "cpx \"templates/**/*\" dist/templates",
        "start": "node dist/src/server.js",
        "start:prod": "npm run build && npm run start",
        "seed:admin": "ts-node -r tsconfig-paths/register ./src/seeds/superAdmin.seed.ts",
        "seed:plans": "ts-node -r tsconfig-paths/register ./src/seeds/plans.seed.ts",
        "seed:settings": "ts-node -r tsconfig-paths/register ./src/seeds/settings.seed.ts",
        "seed:all": "npm run seed:admin && npm run seed:plans && npm run seed:settings",
        "setup:https:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-local-https.ps1",
        "setup:https:starter": "npm run setup:https:windows -- -Domain starter-mongoose.localhost && docker compose restart nginx",
        "docker:up": "docker compose up --build",
        "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up",
        "docker:dev:build": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
        "docker:prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build",
        "docker:up:https:windows": "npm run setup:https:windows && docker compose up -d --build",
        "docker:down": "docker compose down",
        "docker:down:volumes": "docker compose down -v",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "test": "jest --runInBand --detectOpenHandles",
        "test:watch": "jest --watch"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1062.0",
        "@aws-sdk/client-sesv2": "^3.1062.0",
        "@aws-sdk/lib-storage": "^3.1062.0",
        "@socket.io/redis-adapter": "^8.3.0",
        "bcryptjs": "^3.0.3",
        "bullmq": "^5.70.1",
        "cloudinary": "^2.9.0",
        "compression": "^1.8.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.3.1",
        "ejs": "^4.0.1",
        "express": "^5.2.1",
        "express-rate-limit": "^8.2.1",
        "firebase-admin": "^13.10.0",
        "helmet": "^8.1.0",
        "hpp": "^0.2.3",
        "ioredis": "^5.9.3",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^9.2.3",
        "morgan": "^1.10.1",
        "multer": "^2.0.2",
        "node-fetch": "^3.3.2",
        "nodemailer": "^8.0.1",
        "redis": "^5.11.0",
        "socket.io": "^4.8.1",
        "stripe": "^22.2.2",
        "winston": "^3.19.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/compression": "^1.8.1",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/ejs": "^3.1.5",
        "@types/express": "^5.0.6",
        "@types/hpp": "^0.2.7",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/multer": "^2.0.0",
        "@types/node": "^25.3.2",
        "@types/nodemailer": "^7.0.11",
        "@types/supertest": "^7.2.0",
        "@typescript-eslint/eslint-plugin": "^8.56.1",
        "@typescript-eslint/parser": "^8.56.1",
        "cpx": "^1.5.0",
        "eslint": "^10.0.2",
        "eslint-config-prettier": "^10.1.8",
        "jest": "^30.2.0",
        "nodemon": "^3.1.14",
        "npm-check-updates": "^19.6.2",
        "prettier": "^3.8.1",
        "socket.io-client": "^4.8.1",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.6",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.16",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.23.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.1"
    },
    "allowScripts": {
        "@firebase/util@1.15.1": true,
        "core-js@2.6.12": true,
        "esbuild@0.28.1": true,
        "msgpackr-extract@3.0.3": true,
        "protobufjs@7.6.0": true,
        "unrs-resolver@1.11.1": true
    }
}
