# Environment sample
# Local host development defaults are below.
# For Docker Compose, use:
# MONGODB_URI=mongodb://mongo:27017/backend_template
# REDIS_HOST=redis
# SMTP_HOST=mailhog
# mongo-express: http://localhost:8081
# nginx (backend entrypoint): https://localhost
# trusted cert setup (Windows): npm run setup:https:windows

NODE_ENV=development
PORT=5000
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=443
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:5000,https://localhost
REQUEST_TIMEOUT_MS=15000
SHUTDOWN_TIMEOUT_MS=10000
SOCKET_IO_PATH=/socket.io
SOCKET_IO_PING_INTERVAL_MS=25000
SOCKET_IO_PING_TIMEOUT_MS=20000
SOCKET_IO_CONNECT_TIMEOUT_MS=45000
SOCKET_IO_MAX_PAYLOAD_BYTES=1000000
SOCKET_IO_MESSAGE_RATE_LIMIT_PER_MINUTE=120
SOCKET_IO_CHAT_MAX_MESSAGE_LENGTH=2000
SOCKET_IO_USE_REDIS_ADAPTER=true

MONGODB_URI=mongodb://localhost:27017/backend_template
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=20
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=admin123

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_KEEP_ALIVE_MS=30000
REDIS_COMMAND_TIMEOUT_MS=2000

JWT_ACCESS_SECRET=replace_with_at_least_32_chars_access_secret_value
JWT_REFRESH_SECRET=replace_with_at_least_32_chars_refresh_secret_value
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7
JWT_VERIFY_EMAIL_EXPIRATION_HOURS=24
JWT_RESET_PASSWORD_EXPIRATION_HOURS=1

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://localhost/api/v1/auth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=https://localhost/api/v1/auth/facebook/callback
APPLE_CLIENT_ID=

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@example.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

FIREBASE_CONFIG_PATH=./src/config/your-firebase-config.json

# AWS / floci Configuration
AWS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_BUCKET=drft-uploads
AWS_SES_FROM_EMAIL=noreply@drft.app

# Storage mode: 'local' (default) | 's3' | 'cloudinary'
STORAGE_MODE=local

# App Configuration
APP_NAME=DRFT

# Auth Configuration
AUTH_MAX_FAILED_ATTEMPTS=10
AUTH_LOCK_DURATION_MINUTES=60
OTP_EXPIRES_MINUTES=10

SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe@12345
