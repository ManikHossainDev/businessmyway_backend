<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Payment Cancelled</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');
    body { margin: 0; padding: 0; background-color: #f0f2f5; font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; }
    .container { max-width: 520px; margin: 0 auto; padding: 40px 20px; }
    .card { background: #ffffff; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden; text-align: center; }
    .hero { background: linear-gradient(135deg, #dc2626 0%, #ef4444 100%); padding: 40px 20px; }
    .cancel-icon { width: 80px; height: 80px; margin: 0 auto 20px; border-radius: 50%; background: #ffffff; display: flex; align-items: center; justify-content: center; animation: scaleIn 0.5s ease-out; }
    .cancel-icon svg { width: 40px; height: 40px; stroke: #dc2626; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; fill: none; }
    @keyframes scaleIn { from { transform: scale(0); } to { transform: scale(1); } }
    .title { margin: 0 0 8px; font-size: 24px; font-weight: 700; color: #ffffff; }
    .subtitle { margin: 0; font-size: 14px; color: rgba(255,255,255,0.9); }
    .content { padding: 30px 24px; }
    .message { color: #4b5563; font-size: 15px; line-height: 1.6; margin-bottom: 24px; }
    .btn { display: inline-block; padding: 14px 32px; background: #0348AC; color: #ffffff; text-decoration: none; border-radius: 10px; font-weight: 600; font-size: 15px; transition: background 0.2s, transform 0.1s; margin: 8px; }
    .btn:hover { background: #1d4ed8; transform: translateY(-1px); }
    .footer { padding: 20px; font-size: 12px; color: #9ca3af; }
    @media only screen and (max-width: 620px) {
      .container { padding: 20px 12px; }
      .hero { padding: 32px 16px; }
      .content { padding: 24px 16px; }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="card">
      <div class="hero">
        <div class="cancel-icon">
          <svg viewBox="0 0 24 24">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y2="6" x2="18" y1="18"></line>
          </svg>
        </div>
        <h1 class="title">Payment Cancelled</h1>
        <p class="subtitle">Your transaction was not completed</p>
      </div>
      <div class="content">
        <p class="message">
          Your payment has been cancelled. No charges were made to your account.
          You can try again or return to browse more options.
        </p>
        <div>
          <a href="<%= clientUrl %>" class="btn">Try Again</a>
        </div>
      </div>
      <div class="footer">
        <p style="margin: 0;">Need help? Contact support@drft.app</p>
      </div>
    </div>
  </div>
</body>
</html>
