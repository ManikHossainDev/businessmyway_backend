<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Payment Successful</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');
    * { box-sizing: border-box; }
    body { margin: 0; padding: 0; background-color: #f0f2f5; font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; }
    .container { max-width: 520px; margin: 0 auto; padding: 40px 20px; }
    .card { background: #ffffff; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden; }
    .hero { background: linear-gradient(135deg, #0a7c4e 0%, #0d9e63 60%, #10b77a 100%); padding: 40px 20px; text-align: center; }
    .checkmark-wrapper { width: 80px; height: 80px; margin: 0 auto 20px; position: relative; }
    .checkmark-circle { width: 80px; height: 80px; border-radius: 50%; background: #ffffff; display: block; stroke-width: 2; stroke: #0a7c4e; stroke-miterlimit: 10; box-shadow: 0 0 0 rgba(255,255,255,0.4); animation: circleFadeIn 0.4s ease-out forwards; }
    .checkmark-check { transform-origin: 50% 50%; stroke-dasharray: 48; stroke-dashoffset: 48; animation: strokeDraw 0.4s 0.3s ease-out forwards; }
    @keyframes circleFadeIn { 0% { opacity: 0; transform: scale(0); } 50% { transform: scale(1.1); } 100% { opacity: 1; transform: scale(1); } }
    @keyframes strokeDraw { 100% { stroke-dashoffset: 0; } }
    .title { margin: 0 0 8px; font-size: 24px; font-weight: 700; color: #ffffff; }
    .subtitle { margin: 0; font-size: 14px; color: rgba(255,255,255,0.9); }
    .content { padding: 30px 24px; }
    .details-section { background: #f8f9ff; border-radius: 12px; padding: 18px 20px; margin-bottom: 24px; }
    .detail-row { display: flex; justify-content: space-between; align-items: center; padding: 6px 0; }
    .detail-label { font-size: 12px; color: #6b7280; }
    .detail-value { font-size: 13px; color: #1a1a2e; font-weight: 600; text-align: right; }
    .detail-divider { border: 0; border-top: 1px solid #e5e7eb; margin: 8px 0; }
    .amount-row .detail-value { font-size: 16px; color: #0a7c4e; font-weight: 800; }
    .message { color: #4b5563; font-size: 15px; line-height: 1.6; margin-bottom: 24px; text-align: center; }
    .btn { display: inline-block; padding: 14px 32px; background: #0348AC; color: #ffffff; text-decoration: none; border-radius: 10px; font-weight: 600; font-size: 15px; transition: background 0.2s, transform 0.1s; }
    .btn:hover { background: #1d4ed8; transform: translateY(-1px); }
    .btn-secondary { background: #6b7280; }
    .btn-secondary:hover { background: #4b5563; }
    .actions { text-align: center; }
    .footer { padding: 20px; text-align: center; font-size: 12px; color: #9ca3af; }
    @media only screen and (max-width: 620px) {
      .container { padding: 20px 12px; }
      .hero { padding: 32px 16px; }
      .content { padding: 24px 16px; }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="card">
      <div class="hero">
        <div class="checkmark-wrapper">
          <svg class="checkmark-circle" viewBox="0 0 52 52" xmlns="http://www.w3.org/2000/svg">
            <circle class="checkmark-circle-bg" cx="26" cy="26" r="25" fill="none" stroke="none" />
            <path class="checkmark-check" fill="none" d="M14 27l7 7 16-16" stroke="#0a7c4e" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <h1 class="title">Payment Successful</h1>
        <p class="subtitle">Your transaction has been completed</p>
      </div>
      <div class="content">
        <% if (locals.payment) { %>
        <div class="details-section">
          <div class="detail-row">
            <span class="detail-label">Payment ID</span>
            <span class="detail-value"><%= payment.id %></span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Subscription / Plan</span>
            <span class="detail-value"><%= payment.title %></span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Type</span>
            <span class="detail-value"><%= payment.paymentType %></span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Billing Cycle</span>
            <span class="detail-value" style="text-transform:capitalize;"><%= payment.billingType %></span>
          </div>
          <hr class="detail-divider" />
          <div class="detail-row amount-row">
            <span class="detail-label">Amount Paid</span>
            <span class="detail-value"><%= payment.currency %> <%= Number(payment.amount).toFixed(2) %></span>
          </div>
          <% if (locals.payment.invoiceId) { %>
          <div class="detail-row">
            <span class="detail-label">Invoice ID</span>
            <span class="detail-value" style="font-family:monospace;"><%= payment.invoiceId %></span>
          </div>
          <% } %>
        </div>
        <% } else { %>
        <p class="message">
          Your payment was successful and your subscription has been activated.
        </p>
        <% } %>
        <div class="actions">
          <a href="<%= clientUrl %>" class="btn">Go Back to Dashboard</a>
        </div>
      </div>
      <div class="footer">
        <p style="margin: 0;">Need help? Contact support@drft.app</p>
      </div>
    </div>
  </div>
</body>
</html>