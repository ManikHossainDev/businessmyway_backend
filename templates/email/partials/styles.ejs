<![endif]-->
<style type="text/css">
  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');

  body { margin: 0; padding: 0; background-color: #F5F6FA; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
  img  { border: 0; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic; }
  table { border-collapse: collapse !important; mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
  a[x-apple-data-detectors] { color: inherit !important; text-decoration: none !important; font-size: inherit !important; font-family: inherit !important; font-weight: inherit !important; line-height: inherit !important; }

  /* Layout */
  .ew  { max-width: 620px; width: 100%; }
  .ep  { padding: 24px 16px; }
  .eh  { padding: 28px 16px; }
  .ef  { padding: 16px 16px 20px; }
  .dp  { padding: 0 16px; }
  .sf  { padding: 18px 14px 0; }

  /* Typography */
  .ht  { font-size: 20px; font-weight: 700; color: #ffffff; line-height: 1.3; letter-spacing: -0.3px; }
  .hs  { font-size: 13px; font-weight: 400; color: rgba(255,255,255,0.72); line-height: 1.5; }
  .bt  { font-size: 14px; color: #374151; line-height: 1.65; }
  .st  { font-size: 12px; color: #6B7280; line-height: 1.6; }
  .tt  { font-size: 11px; color: #9CA3AF; line-height: 1.6; }

  /* Components */
  .btn         { display: inline-block; padding: 15px 48px; background: #0348AC; color: #ffffff; text-decoration: none; border-radius: 10px; font-weight: 700; font-size: 15px; font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; line-height: 1; letter-spacing: 0.1px; }
  .otp-num     { font-size: 32px; font-weight: 700; letter-spacing: 10px; color: #0348AC; font-family: 'Courier New', Courier, monospace; line-height: 1.1; }
  .otp-pad     { background: #EEF3FC; border: 2px solid #0348AC; border-radius: 14px; padding: 20px 24px; text-align: center; }
  .alert-pad   { background: #FFF7ED; border-left: 4px solid #F26A2F; border-radius: 0 10px 10px 0; padding: 12px 14px; }
  .info-pad    { background: #F3F4F6; border-radius: 12px; padding: 14px 16px; }
  .success-pad { background: #ECFDF5; border-left: 4px solid #059669; border-radius: 0 12px 12px 0; padding: 14px 16px; }
  .danger-pad  { background: #FEF2F2; border-left: 4px solid #DC2626; border-radius: 0 10px 10px 0; padding: 12px 14px; }

  /* Steps */
  .sn { width: 34px; height: 34px; border-radius: 10px; text-align: center; line-height: 34px; color: #ffffff; font-weight: 700; font-size: 13px; }
  .sg { vertical-align: top; padding-left: 12px; }
  .sl { font-size: 13px; font-weight: 700; color: #171717; line-height: 1.4; margin: 0 0 3px; }
  .sd { font-size: 12px; color: #6B7280; line-height: 1.55; margin: 0; }
  .sr { padding-bottom: 16px; }

  /* Payment table */
  .row-l   { font-size: 12px; color: #6B7280; width: 46%; }
  .row-v   { font-size: 13px; color: #171717; font-weight: 600; text-align: right; }
  .sum-pad { padding: 16px 18px; }

  /* Mobile */
  @media only screen and (max-width: 620px) {
    .ew  { max-width: 100% !important; }
    .ep  { padding: 20px 14px !important; }
    .eh  { padding: 24px 14px !important; }
    .ef  { padding: 14px 14px 18px !important; }
    .btn { display: block !important; width: 100% !important; text-align: center !important; box-sizing: border-box !important; padding: 15px 20px !important; }
    .otp-num { font-size: 28px !important; letter-spacing: 8px !important; }
  }

  /* Desktop */
  @media only screen and (min-width: 621px) {
    .ew      { max-width: 620px !important; }
    .ep      { padding: 28px 32px !important; }
    .eh      { padding: 32px 32px !important; }
    .ef      { padding: 18px 32px 22px !important; }
    .dp      { padding: 0 32px !important; }
    .sf      { padding: 20px 16px 0 !important; }
    .otp-num { font-size: 46px !important; letter-spacing: 14px !important; }
    .otp-pad { padding: 24px 32px !important; }
  }
</style>
