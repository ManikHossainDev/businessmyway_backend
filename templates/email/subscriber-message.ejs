<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= typeof subject !== 'undefined' ? subject : 'Message from British Smokes' %></title>
  <%- include("partials/styles") %>
</head>
<body style="margin:0;padding:0;background-color:#F5F6FA;font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F5F6FA;">
    <tr>
      <td align="center" style="padding:32px 12px 44px;">
        <%- include("partials/logo") %>
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:620px;margin:0 auto;background:#ffffff;border-radius:16px;overflow:hidden;">
          <tr>
            <td style="padding:36px 24px 16px;text-align:center;border-bottom:1px solid #E5E7EB;">
              <h1 style="margin:0;font-size:22px;font-weight:700;color:#C1892F;">
                <%= typeof subject !== 'undefined' ? subject : 'A message from British Smokes' %>
              </h1>
            </td>
          </tr>
          <tr>
            <td style="padding:28px 24px;">
              <p style="margin:0 0 16px;font-size:14px;color:#374151;">
                Hi <strong><%= typeof name !== 'undefined' ? name : 'there' %></strong>,
              </p>
              <% (typeof message === 'string' ? message.split('\n') : []).forEach(function(line) { %>
                <p style="margin:0 0 12px;font-size:14px;line-height:1.7;color:#6B7280;"><%= line || '&nbsp;' %></p>
              <% }) %>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
