<!doctype html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
  <meta name="x-apple-disable-message-reformatting"/>
  <meta name="color-scheme" content="light"/>
  <meta name="supported-color-schemes" content="light"/>
  <title>Payment Confirmation</title>
  <%- include("partials/styles") %>
</head>
<body style="margin:0;padding:0;background-color:#F5F6FA;font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;">

  <!-- Preheader -->
  <div style="display:none;max-height:0;overflow:hidden;font-size:1px;color:#F5F6FA;line-height:1px;">
    Payment confirmed! Your <%= subscriptionTitle %> subscription is now active.&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F5F6FA;">
    <tr>
      <td align="center" style="padding:32px 12px 44px;">

        <!-- Logo — above card -->
        <%- include("partials/logo") %>

        <!-- Card -->
        <table role="presentation" class="ew" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:620px;margin:0 auto;background:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,0.06),0 8px 28px rgba(3,72,172,0.08);">

          <!-- Hero header -->
          <tr>
            <td style="background:#ffffff;padding:36px 24px 28px;text-align:center;border-bottom:1px solid #E5E7EB;">
              <p style="margin:0 0 14px;font-size:44px;line-height:1;mso-line-height-rule:exactly;">&#127881;</p>
              <h1 style="margin:0 0 8px;font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;font-size:24px;font-weight:700;color:#0348AC;line-height:1.25;letter-spacing:-0.4px;">
                Payment Successful
              </h1>
              <p style="margin:0;font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;font-size:14px;font-weight:400;color:#6B7280;line-height:1.55;">
                Your subscription has been activated.
              </p>
            </td>
          </tr>

          <!-- Greeting -->
          <tr>
            <td class="ep" style="padding:28px 24px 12px;">
              <p style="margin:0 0 14px;font-size:14px;line-height:1.65;color:#374151;font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
                Hi <strong style="color:#171717;font-weight:600;"><%= typeof userName !== 'undefined' ? userName : 'there' %></strong>,
              </p>
              <p style="margin:0;font-size:14px;line-height:1.7;color:#6B7280;font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
                Thank you for your payment. Your <strong style="color:#171717;font-weight:600;"><%= subscriptionTitle %></strong> plan is now active.
              </p>
            </td>
          </tr>

          <!-- Payment summary -->
          <tr>
            <td style="padding:0 24px 8px;">
              <p style="margin:0 0 10px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:2px;color:#9CA3AF;font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
                Payment Summary
              </p>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#F3F4F6;border-radius:12px;overflow:hidden;">
                <tr>
                  <td class="sum-pad" style="padding:16px 18px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
                      <tr>
                        <td class="row-l" style="padding:6px 0;font-size:12px;color:#6B7280;width:46%;">Subscription</td>
                        <td class="row-v" style="padding:6px 0;font-size:13px;color:#171717;font-weight:600;text-align:right;"><%= subscriptionTitle %></td>
                      </tr>
                      <tr>
                        <td class="row-l" style="padding:6px 0;font-size:12px;color:#6B7280;">Type</td>
                        <td class="row-v" style="padding:6px 0;font-size:13px;color:#171717;font-weight:600;text-align:right;"><%= paymentType %></td>
                      </tr>
                      <tr>
                        <td class="row-l" style="padding:6px 0;font-size:12px;color:#6B7280;">Billing Cycle</td>
                        <td class="row-v" style="padding:6px 0;font-size:13px;color:#171717;font-weight:600;text-align:right;text-transform:capitalize;"><%= billingType %></td>
                      </tr>
                      <tr>
                        <td colspan="2" style="padding:8px 0 4px;"><div style="border-top:1px solid #E5E7EB;font-size:0;line-height:0;">&nbsp;</div></td>
                      </tr>
                      <tr>
                        <td class="row-l" style="padding:6px 0;font-size:12px;color:#6B7280;">Amount Paid</td>
                        <td style="padding:6px 0;font-size:16px;color:#0348AC;font-weight:800;text-align:right;font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
                          <%= currency.toUpperCase() %>&nbsp;<%= Number(amount).toFixed(2) %>
                        </td>
                      </tr>
                      <tr>
                        <td class="row-l" style="padding:6px 0;font-size:12px;color:#6B7280;">Date</td>
                        <td class="row-v" style="padding:6px 0;font-size:13px;color:#171717;font-weight:600;text-align:right;">
                          <%= new Date(paidAt).toLocaleDateString('en-US', { year:'numeric', month:'long', day:'numeric' }) %>
                        </td>
                      </tr>
                      <tr>
                        <td class="row-l" style="padding:6px 0;font-size:12px;color:#6B7280;">Invoice ID</td>
                        <td class="row-v" style="padding:6px 0;font-size:13px;color:#171717;font-weight:600;text-align:right;font-family:'Courier New',Courier,monospace;"><%= invoiceId %></td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Activated banner -->
          <tr>
            <td style="padding:12px 24px 8px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td class="success-pad" style="background:#ECFDF5;border-left:4px solid #059669;border-radius:0 12px 12px 0;padding:14px 16px;">
                    <p style="margin:0 0 4px;font-size:13px;font-weight:700;color:#065F46;font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">&#10003;&nbsp; Subscription Activated</p>
                    <p style="margin:0;font-size:13px;color:#047857;line-height:1.55;font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
                      Your <strong><%= subscriptionTitle %></strong> (<%= billingType %>) plan is active &mdash; you can start using all plan features immediately.
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Invoice links -->
          <% if ((typeof invoiceUrl !== 'undefined' && invoiceUrl) || (typeof invoicePdf !== 'undefined' && invoicePdf)) { %>
          <tr>
            <td style="padding:12px 24px 8px;">
              <p style="margin:0 0 8px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:2px;color:#9CA3AF;font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
                Invoice
              </p>
              <% if (typeof invoiceUrl !== 'undefined' && invoiceUrl) { %>
              <p style="margin:0 0 6px;font-size:13px;line-height:1.6;font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
                <a href="<%= invoiceUrl %>" style="color:#0348AC;text-decoration:none;font-weight:600;">&#128196;&nbsp; View Receipt &rarr;</a>
              </p>
              <% } %>
              <% if (typeof invoicePdf !== 'undefined' && invoicePdf) { %>
              <p style="margin:0;font-size:13px;line-height:1.6;font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
                <a href="<%= invoicePdf %>" style="color:#0348AC;text-decoration:none;font-weight:600;">&#128196;&nbsp; Download Invoice PDF &rarr;</a>
              </p>
              <% } %>
            </td>
          </tr>
          <% } %>

          <!-- Support -->
          <tr>
            <td style="padding:12px 24px 24px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#EEF3FC;border-radius:12px;">
                <tr>
                  <td style="padding:16px 20px;">
                    <p style="margin:0;font-size:12px;color:#374151;line-height:1.65;font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
                      Questions about your payment? Reach us any time at <a href="mailto:support@drft.app" style="color:#0348AC;font-weight:600;text-decoration:none;">support@drft.app</a>
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Divider -->
          <tr>
            <td style="padding:0 24px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr><td style="border-top:1px solid #E5E7EB;font-size:0;line-height:0;">&nbsp;</td></tr>
              </table>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td><%- include("partials/footer") %></td>
          </tr>

        </table>

        <!-- Copyright -->
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="max-width:620px;width:100%;margin:0 auto;">
          <tr>
            <td align="center" style="padding:20px 16px 0;font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;font-size:11px;line-height:1.6;color:#9CA3AF;">
              <p style="margin:0;">&copy; <%= new Date().getFullYear() %> <%= appName %>. All rights reserved.</p>
            </td>
          </tr>
        </table>

      </td>
    </tr>
  </table>

</body>
</html>
