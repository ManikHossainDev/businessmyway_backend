<!doctype html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
  <meta name="x-apple-disable-message-reformatting"/>
  <meta name="color-scheme" content="light"/>
  <meta name="supported-color-schemes" content="light"/>
  <title>Reset Your Password</title>
  <%- include("partials/styles") %>
</head>
<body style="margin:0;padding:0;background-color:#F5F6FA;font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;">

  <!-- Preheader -->
  <div style="display:none;max-height:0;overflow:hidden;font-size:1px;color:#F5F6FA;line-height:1px;">
    Your password reset code is <%= otp %> &mdash; expires in <%= typeof expiresInMinutes !== 'undefined' ? expiresInMinutes : 60 %> min.&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;&#847;
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F5F6FA;">
    <tr>
      <td align="center" style="padding:32px 12px 44px;">

        <!-- Logo — above card -->
        <%- include("partials/logo") %>

        <!-- Card -->
        <table role="presentation" class="ew" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:620px;margin:0 auto;background:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,0.06),0 8px 28px rgba(3,72,172,0.08);">

          <!-- Hero header -->
          <tr>
            <td style="background:#ffffff;padding:36px 24px 28px;text-align:center;border-bottom:1px solid #E5E7EB;">
              <p style="margin:0 0 14px;font-size:44px;line-height:1;mso-line-height-rule:exactly;">&#128273;</p>
              <h1 style="margin:0 0 8px;font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;font-size:24px;font-weight:700;color:#0348AC;line-height:1.25;letter-spacing:-0.4px;">
                Reset Your Password
              </h1>
              <p style="margin:0;font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;font-size:14px;font-weight:400;color:#6B7280;line-height:1.55;">
                Use the code below to set a new password.
              </p>
            </td>
          </tr>

          <!-- Greeting -->
          <tr>
            <td class="ep" style="padding:28px 24px 8px;">
              <p style="margin:0 0 14px;font-size:14px;line-height:1.65;color:#374151;font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
                Hi <strong style="color:#171717;font-weight:600;"><%= typeof fullName !== 'undefined' ? fullName : 'there' %></strong>,
              </p>
              <p style="margin:0;font-size:14px;line-height:1.7;color:#6B7280;font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
                We received a request to reset the password for your account. Enter the verification code below to continue:
              </p>
            </td>
          </tr>

          <!-- OTP box -->
          <tr>
            <td style="padding:20px 24px 8px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="center">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:340px;">
                      <tr>
                        <td class="otp-pad" style="background:#EEF3FC;border:2px solid #0348AC;border-radius:14px;padding:20px 24px;text-align:center;">
                          <p style="margin:0 0 8px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:2px;color:#6B7280;font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
                            Password Reset Code
                          </p>
                          <p class="otp-num" style="margin:0;font-size:34px;font-weight:700;letter-spacing:10px;color:#0348AC;font-family:'Courier New',Courier,monospace;line-height:1.1;">
                            <%= otp %>
                          </p>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Expiry alert -->
          <tr>
            <td style="padding:12px 24px 4px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td class="alert-pad" style="background:#FFF7ED;border-left:4px solid #F26A2F;border-radius:0 10px 10px 0;padding:12px 14px;">
                    <p style="margin:0;font-size:13px;color:#9A3412;line-height:1.55;font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
                      &#9200;&nbsp; This code expires in <strong><%= typeof expiresInMinutes !== 'undefined' ? expiresInMinutes : 60 %> minutes</strong>. Do not share it with anyone.
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Security note -->
          <tr>
            <td style="padding:16px 24px 24px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td class="info-pad" style="background:#F3F4F6;border-radius:12px;padding:14px 16px;">
                    <p style="margin:0;font-size:13px;color:#6B7280;line-height:1.6;font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
                      &#128274;&nbsp; <strong style="color:#374151;">Didn&rsquo;t request this?</strong> Your account is still secure &mdash; you can safely ignore this email.
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Divider -->
          <tr>
            <td style="padding:0 24px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr><td style="border-top:1px solid #E5E7EB;font-size:0;line-height:0;">&nbsp;</td></tr>
              </table>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td><%- include("partials/footer") %></td>
          </tr>

        </table>

        <!-- Copyright -->
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="max-width:620px;width:100%;margin:0 auto;">
          <tr>
            <td align="center" style="padding:20px 16px 0;font-family:'Poppins',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;font-size:11px;line-height:1.6;color:#9CA3AF;">
              <p style="margin:0;">&copy; <%= new Date().getFullYear() %> <%= appName %>. All rights reserved.</p>
            </td>
          </tr>
        </table>

      </td>
    </tr>
  </table>

</body>
</html>
